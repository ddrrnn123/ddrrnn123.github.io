---
layout: page
---
<div class="post">
  <article>
    {% if page.profile_groups %}
      {% for group in page.profile_groups %}
        <h2 class="section-heading people-section">{{ group.title }}</h2>
        <div class="people-grid people-grid--centered">
          {% for profile in group.people %}
            <div class="person-card{% if profile.placeholder %} person-card--placeholder{% endif %}">
              {% if profile.image %}
                {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                {% capture sizes %}(min-width: 992px) 180px, (min-width: 576px) 30vw, 60vw{% endcapture %}
                {% include figure.liquid loading="eager" path=profile_image_path class="person-photo person-photo--circular" sizes=sizes alt=profile.name zoomable=false %}
              {% endif %}
              <div class="person-name">{{ profile.name }}</div>
              {% if profile.role %}
                <div class="person-role">{{ profile.role }}</div>
              {% endif %}
              {% if profile.position %}
                <div class="person-position">{{ profile.position }}</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    {% endif %}

    <div class="profiles-extra">
      {{ content }}
    </div>
  </article>
</div>
